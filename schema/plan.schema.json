          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sfx": {
            "type": "boolean"
          },
          "frame": {
            "type": "object",
            "properties": {
              "radius": {
                "type": "number",
                "minimum": 0
              },
              "border": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "number",
                        "minimum": 0
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
