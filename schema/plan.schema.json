                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0
                      },
                      "padX": {
                        "type": "number",
                        "minimum": 0
                      },
                      "padY": {
                        "type": "number",
                        "minimum": 0
                      },
                      "borderWidth": {
                        "type": "number",
                        "minimum": 0
                      },
                      "borderColor": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      }
