        "conceptTyping": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagramOpen": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagramElement": {
          "type": [
            "string",
            "null"
          ]
        },
        "gauge": {
          "type": [
            "string",
            "null"
          ]
        },
