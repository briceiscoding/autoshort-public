      "type": "object",
      "properties": {
        "rush": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crop": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
