    "subscribe": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0
            },
            "trigger": {
              "type": "string"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "keyColor": {
              "type": "string"
            },
            "enter": {
              "type": "string",
              "enum": [
