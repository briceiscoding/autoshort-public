              "shadow": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "blur": {
                        "type": "number",
                        "minimum": 0
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "blur",
                      "color",
                      "opacity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
