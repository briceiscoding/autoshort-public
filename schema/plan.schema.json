                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "width",
                      "color",
                      "opacity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
